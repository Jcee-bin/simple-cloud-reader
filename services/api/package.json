{
  "name": "@simple-cloud-reader/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "maintenance": "node dist/src/maintenance.js",
    "test": "vitest run --exclude dist/**",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1077.0",
    "@aws-sdk/s3-request-presigner": "3.1077.0",
    "@simple-cloud-reader/sync-contract": "0.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.9.0",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "4.1.8"
  }
}
